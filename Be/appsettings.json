{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "game-of-tag",
    "Audience": "game-of-tag-clients",
    "TokenLifetimeHours": 24
  },
  "FireRules": {
    "MinShotIntervalMs": 250,
    "MaxClockSkewMs": 2000,
    "MaxTargetsPerShotLimit": 16,
    "MaxShotIdLength": 128
  },
  "Markers": {
    "DictionarySize": 50
  },
  "RespawnSweeper": {
    "Enabled": true,
    "IntervalMs": 250
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
